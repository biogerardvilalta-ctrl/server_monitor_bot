# Token del Bot de Telegram (donat per @BotFather)
TELEGRAM_BOT_TOKEN=el_teu_token_aqui

# El teu Chat ID de Telegram (donat per @userinfobot)
# Només aquest ID podrà parlar amb el bot
ALLOWED_CHAT_ID=el_teu_chat_id_aqui

# Hetzner API Token (opcional, per hard resets i power on/off)
HETZNER_API_TOKEN=el_teu_token_hetzner_aqui

# Nom del servidor per mostrar als missatges
SERVER_NAME=Hetzner-Gerard

# Llindars d'alerta (percentatges)
ALERT_CPU_THRESHOLD=85
ALERT_RAM_THRESHOLD=90
ALERT_DISK_THRESHOLD=85
